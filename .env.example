# Copy this file to .env and fill in the values from https://sanity.io/manage
#
# Leave SANITY_PROJECT_ID empty (or delete .env entirely) and the site builds from the
# markdown files in src/content/products/ exactly as it did before — nothing breaks.
# Set it, and product categories come from Sanity instead.

SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only needed if the dataset is private. A public dataset needs no token.
# SANITY_READ_TOKEN=

# Used only by scripts/migrate-products-to-sanity.mjs — an Editor token.
# Never commit this.
# SANITY_WRITE_TOKEN=

# --- Studio (studio/ folder) ---
# The Studio reads its own SANITY_STUDIO_* variables from studio/.env
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
