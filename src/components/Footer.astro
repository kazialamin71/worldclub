---
import { SITE, CONTACT, NAV } from '~/consts';
import company from '~/data/company.json';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

/* The footer shows a shortlist, not the whole catalogue — but every trading division has to
   be reachable from it, so take the first few and then top up with any division the cut
   left out entirely. */
const shortlist = products.slice(0, 8);
const orphanedDivisions = products.filter(
  (p) => !shortlist.some((s) => s.data.division === p.data.division),
);
const footerProducts = [
  ...shortlist,
  ...orphanedDivisions.filter(
    (p, i) => orphanedDivisions.findIndex((o) => o.data.division === p.data.division) === i,
  ),
];

const year = new Date().getFullYear();
const hq = company.offices.find((o) => o.isHq)!;
---
<footer class="texture-weave mt-24 bg-brand-950 text-white/70">
  <div class="container-page grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <Logo tone="light" withTagline />
      <p class="mt-5 max-w-sm text-sm leading-relaxed">
        {SITE.tagline}. Premium food import, national distribution and direct export from
        Dhaka — under ISO 9001, ISO 22000 and HACCP certified management systems.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {['ISO 9001:2015', 'ISO 22000:2018', 'HACCP', 'DCCI-08461'].map((b) => (
          <li class="rounded-full border border-white/15 px-3 py-1 text-[0.7rem] font-medium tracking-wide text-gold-200">{b}</li>
        ))}
      </ul>
    </div>

    <nav class="lg:col-span-2" aria-label="Company">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.12em] text-white">Company</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {NAV.map((i) => (
          <li><a href={i.href} class="transition hover:text-gold-200">{i.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="lg:col-span-3" aria-label="Product categories">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.12em] text-white">Product range</h2>
      <ul class="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2 lg:grid-cols-1">
        {footerProducts.map((p) => (
          <li><a href={`/products/${p.id}`} class="transition hover:text-gold-200">{p.data.title}</a></li>
        ))}
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.12em] text-white">Get in touch</h2>
      <address class="mt-5 space-y-4 text-sm not-italic">
        <p class="flex gap-3">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-gold-300" />
          <span>{hq.address}</span>
        </p>
        <p class="flex gap-3">
          <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-gold-300" />
          <span>
            <a href={`tel:+${CONTACT.phonePrimaryRaw}`} class="transition hover:text-gold-200">{CONTACT.phonePrimary}</a><br />
            <span class="text-white/50">{CONTACT.phoneSecondary}</span>
          </span>
        </p>
        <p class="flex gap-3">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-gold-300" />
          <a href={`mailto:${CONTACT.email}`} class="break-all transition hover:text-gold-200">{CONTACT.email}</a>
        </p>
      </address>
      <p class="mt-6 text-xs leading-relaxed text-white/45">
        Overseas offices: {company.offices.filter((o) => !o.isHq).map((o) => o.country).join(' · ')}
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName}. All rights reserved.</p>
      <p>Trade Licence {company.legal.tradeLicense} · DCCI Membership {company.legal.dcciMembership}</p>
    </div>
  </div>
</footer>
