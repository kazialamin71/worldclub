---
interface Props {
  class?: string;
  /** 'light' = for dark backgrounds, 'dark' = for light backgrounds */
  tone?: 'light' | 'dark';
  withTagline?: boolean;
}
const { class: klass = '', tone = 'dark', withTagline = false } = Astro.props;
const text = tone === 'light' ? 'text-white' : 'text-brand-900';
const sub = tone === 'light' ? 'text-white/60' : 'text-ink-500';

/* The mark is a retouched scan, and parts of its white are enclosed by the swooshes —
   indistinguishable from paper, so they stay opaque. On a light page that reads as the
   background showing through; on a dark one it needs a white tile behind it, which is
   also how the logo is printed. */
const mark = '/images/logo-160.png';
---
<span class={`inline-flex items-center gap-3 ${klass}`}>
  {tone === 'light' ? (
    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-white p-1.5 shadow-sm">
      <img src={mark} alt="" width="188" height="160" class="h-full w-auto" loading="eager" decoding="async" />
    </span>
  ) : (
    <img src={mark} alt="" width="188" height="160" class="h-10 w-auto shrink-0" loading="eager" decoding="async" />
  )}
  <span class="flex flex-col leading-none">
    <span class={`font-display text-[1.3rem] font-semibold tracking-tight ${text}`}>World Club</span>
    {withTagline && (
      <span class={`mt-1 text-[0.62rem] font-medium uppercase tracking-[0.16em] ${sub}`}>
        Import · Export · Distribution
      </span>
    )}
  </span>
</span>
