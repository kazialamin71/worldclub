---
/**
 * Renders a partner/client logo when an image file is supplied, and a clean
 * typographic tile when it is not — so the grid always looks deliberate even
 * before real logo files are dropped into /public/images/.
 */
interface Props {
  name: string;
  note?: string;
  logo?: string;
  meta?: string;
}
const { name, note, logo, meta } = Astro.props;
const initials = name
  .replace(/[^\p{L}\p{N} ]/gu, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('');
---
<div class="group flex h-full flex-col justify-between rounded-xl border border-ink-900/8 bg-white p-5 shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-lift">
  {logo ? (
    <img src={logo} alt={`${name} logo`} width="160" height="64" loading="lazy" decoding="async" class="h-12 w-auto max-w-[10rem] object-contain object-left" />
  ) : (
    <span
      class="inline-flex size-11 items-center justify-center rounded-lg bg-brand-50 font-display text-sm font-semibold text-brand-700 ring-1 ring-brand-900/8"
      aria-hidden="true"
    >{initials}</span>
  )}
  <div class="mt-4">
    <p class="font-medium leading-snug text-brand-950">{name}</p>
    {note && <p class="mt-0.5 text-[0.8rem] text-ink-500">{note}</p>}
    {meta && <p class="mt-1.5 text-[0.75rem] font-medium uppercase tracking-wider text-brand-600">{meta}</p>}
  </div>
</div>
