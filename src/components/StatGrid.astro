---
import company from '~/data/company.json';
interface Props { tone?: 'light' | 'dark'; limit?: number; }
const { tone = 'dark', limit } = Astro.props;
const stats = limit ? company.stats.slice(0, limit) : company.stats;
const dark = tone === 'dark';
---
<dl class:list={[
  'grid gap-px overflow-hidden rounded-2xl',
  dark ? 'bg-white/10' : 'bg-ink-900/8',
  'sm:grid-cols-2 lg:grid-cols-3',
]}>
  {stats.map((s) => (
    <div class:list={['p-6 lg:p-7', dark ? 'bg-brand-950' : 'bg-white']}>
      <dt class:list={['font-display text-[2rem] font-semibold leading-none', dark ? 'text-gold-300' : 'text-brand-700']}>
        {s.value}
      </dt>
      <dd class="mt-3">
        <span class:list={['block text-sm font-semibold', dark ? 'text-white' : 'text-brand-950']}>{s.label}</span>
        <span class:list={['mt-1.5 block text-[0.85rem] leading-relaxed', dark ? 'text-white/55' : 'text-ink-500']}>{s.detail}</span>
      </dd>
    </div>
  ))}
</dl>
