---
import company from '~/data/company.json';
interface Props { tone?: 'light' | 'dark'; limit?: number; }
const { tone = 'dark', limit } = Astro.props;
const stats = limit ? company.stats.slice(0, limit) : company.stats;
const dark = tone === 'dark';

/* The grid is gap-px over a tinted background, so a half-empty last row shows that tint
   as a stray block. Pad it with blank cells — the count differs per breakpoint because
   the column count does. */
const missing = (columns: number) => (columns - (stats.length % columns)) % columns;
const atSm = missing(2);
const atLg = missing(3);
const fillers = Math.max(atSm, atLg);
---
<dl class:list={[
  'grid gap-px overflow-hidden rounded-2xl',
  dark ? 'bg-white/10' : 'bg-ink-900/8',
  'sm:grid-cols-2 lg:grid-cols-3',
]}>
  {stats.map((s) => (
    <div class:list={['p-6 lg:p-7', dark ? 'bg-brand-950' : 'bg-white']}>
      <dt class:list={['font-display text-[2rem] font-semibold leading-none', dark ? 'text-gold-300' : 'text-brand-700']}>
        {s.value}
      </dt>
      <dd class="mt-3">
        <span class:list={['block text-sm font-semibold', dark ? 'text-white' : 'text-brand-950']}>{s.label}</span>
        <span class:list={['mt-1.5 block text-[0.85rem] leading-relaxed', dark ? 'text-white/55' : 'text-ink-500']}>{s.detail}</span>
      </dd>
    </div>
  ))}
  {Array.from({ length: fillers }).map((_, i) => (
    <div
      aria-hidden="true"
      class:list={[
        'hidden',
        i < atSm ? 'sm:block' : 'sm:hidden',
        i < atLg ? 'lg:block' : 'lg:hidden',
        dark ? 'bg-brand-950' : 'bg-white',
      ]}
    />
  ))}
</dl>
