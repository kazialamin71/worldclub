---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { SITE } from '~/consts';

export const getStaticPaths = (async () => {
  const products = await getCollection('products');
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, tagline, summary, items, origins, storage, icon, image, seoTitle, seoDescription } = entry.data;
const { Content } = await render(entry);

const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((p) => p.id !== entry.id).slice(0, 3);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Products', item: `${SITE.url}/products` },
      { '@type': 'ListItem', position: 3, name: title, item: `${SITE.url}/products/${entry.id}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProductGroup',
    name: title,
    description: summary,
    brand: { '@type': 'Brand', name: SITE.name },
    hasVariant: items.map((i) => ({ '@type': 'Product', name: i })),
  },
];
---
<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? summary}
  schema={schema}
>
  <PageHero
    eyebrow={tagline}
    title={title}
    lede={summary}
    crumbs={[{ label: 'Products', href: '/products' }, { label: title, href: `/products/${entry.id}` }]}
  />

  <!-- Spec strip -->
  <section class="border-b border-ink-900/8 bg-white/60">
    <div class="container-page grid gap-6 py-7 sm:grid-cols-3">
      <div>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-brand-600">Lines carried</p>
        <p class="mt-1.5 font-display text-xl text-brand-950">{items.length}</p>
      </div>
      {storage && (
        <div>
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-brand-600">Storage regime</p>
          <p class="mt-1.5 font-display text-xl text-brand-950">{storage}</p>
        </div>
      )}
      <div>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-brand-600">Principal origins</p>
        <p class="mt-1.5 text-[0.95rem] leading-snug text-ink-700">{origins.join(' · ')}</p>
      </div>
    </div>
  </section>

  <section class="container-page grid gap-12 py-16 lg:grid-cols-[1fr_1.15fr] lg:py-20">
    <div>
      {image ? (
        <img src={image} alt={title} width="720" height="540" class="w-full rounded-2xl object-cover shadow-card" loading="lazy" decoding="async" />
      ) : (
        <div class="texture-weave relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-brand-800 via-brand-900 to-brand-950">
          <Icon name={icon} class="size-32 text-gold-300/80" strokeWidth={0.9} />
          <Icon name={icon} class="absolute -bottom-10 -right-8 size-64 text-white/[0.05]" strokeWidth={0.8} />
        </div>
      )}

      <div class="prose-wc mt-8">
        <Content />
      </div>
    </div>

    <div>
      <h2 class="text-2xl text-brand-950">What we carry in {title.toLowerCase()}</h2>
      <p class="mt-2 text-sm text-ink-500">Availability varies by season and shipment. Ask us for the current stock list.</p>
      <ul class="mt-7 grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-2">
        {items.map((item) => (
          <li class="flex items-start gap-2.5 border-b border-ink-900/6 py-2.5 text-[0.93rem] text-ink-700">
            <Icon name="check" class="mt-1 size-3.5 shrink-0 text-brand-500" strokeWidth={2.5} />
            {item}
          </li>
        ))}
      </ul>

      <a href="/contact#enquiry" class="mt-9 inline-flex items-center gap-2 rounded-full bg-brand-800 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-900">
        Request pricing for {title.toLowerCase()} <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </section>

  <section class="border-t border-ink-900/8 bg-white/60 py-16">
    <div class="container-page">
      <h2 class="font-display text-xl text-brand-950">Other categories</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {others.map((p) => (
          <a href={`/products/${p.id}`} class="group flex items-center gap-4 rounded-xl border border-ink-900/8 bg-white p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-lift">
            <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700 ring-1 ring-brand-900/8">
              <Icon name={p.data.icon} class="size-5" />
            </span>
            <span>
              <span class="block font-medium text-brand-950">{p.data.title}</span>
              <span class="mt-0.5 block text-[0.8rem] text-ink-500">{p.data.items.length} lines</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style is:global>
  /* Long-form body copy inside product pages. Kept local and tiny rather than
     pulling in a typography plugin for four rules. */
  .prose-wc p { margin-block: 1rem; line-height: 1.75; color: var(--color-ink-600); }
  .prose-wc p:first-child { margin-top: 0; }
  .prose-wc strong { color: var(--color-brand-900); font-weight: 600; }
  .prose-wc a { color: var(--color-brand-700); text-decoration: underline; text-underline-offset: 3px; }
</style>
