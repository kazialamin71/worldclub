---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ProductCard from '~/components/ProductCard.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { SITE } from '~/consts';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const totalLines = products.reduce((n, p) => n + p.data.items.length, 0);
const allOrigins = [...new Set(products.flatMap((p) => p.data.origins))].sort();

/* Group the catalogue by trading division. The divisions are whatever the content says
   they are — add a category with a new division name in the Studio and a new section
   appears here, in the position its sort order puts it. */
const divisions = [...new Set(products.map((p) => p.data.division))].map((name) => ({
  name,
  entries: products.filter((p) => p.data.division === name),
}));
const grouped = divisions.length > 1;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Products', item: `${SITE.url}/products` },
    ],
  },
];
---
<BaseLayout
  title="Product Range"
  description={`${totalLines}+ imported and exported lines across ${products.length} categories — fresh fruits and vegetables, frozen fish and meat, dairy, bakery, drinks and beverages, edible oils, spices and dry goods, plus electronics and appliances, distributed across Bangladesh.`}
  schema={schema}
>
  <PageHero
    eyebrow="Product range"
    title={`${totalLines}+ lines across ${products.length} categories`}
    lede="Everything World Club imports into Bangladesh and exports out of it, across both trading divisions. Every food category is handled under the storage regime it actually needs — ambient, chilled or deep-frozen."
    crumbs={[{ label: 'Products', href: '/products' }]}
  />

  <!-- Origin summary strip -->
  <section class="border-b border-ink-900/8 bg-white/60">
    <div class="container-page flex flex-wrap items-center gap-x-3 gap-y-2 py-5 text-sm">
      <span class="font-semibold text-brand-950">Principal sourcing origins:</span>
      {allOrigins.map((o) => (
        <span class="rounded-full bg-brand-50 px-3 py-1 text-[0.8rem] font-medium text-brand-800 ring-1 ring-brand-900/8">{o}</span>
      ))}
    </div>
  </section>

  <section class="container-page space-y-14 py-16 lg:py-20">
    {divisions.map((division) => (
      <div>
        {grouped && (
          <div class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-ink-900/8 pb-4">
            <h2 class="text-2xl text-brand-950">{division.name}</h2>
            <p class="text-sm text-ink-500">
              {division.entries.length} {division.entries.length === 1 ? 'category' : 'categories'} ·{' '}
              {division.entries.reduce((n, p) => n + p.data.items.length, 0)} lines
            </p>
          </div>
        )}
        <div class="reveal grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {division.entries.map((entry) => <ProductCard entry={entry} />)}
        </div>
      </div>
    ))}
  </section>

  <section class="container-page pb-4">
    <div class="rounded-2xl border border-ink-900/8 bg-white p-7 shadow-card lg:p-10">
      <div class="flex flex-wrap items-start gap-6">
        <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-900 text-gold-300">
          <Icon name="doc" class="size-6" />
        </span>
        <div class="flex-1">
          <h2 class="text-2xl text-brand-950">Looking for something not listed?</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-ink-600">
            The catalogue above is what we carry regularly. With 39+ supplier relationships across
            15 countries, we also source to order — send us the specification, origin preference and
            volume, and we will come back with options and landed pricing.
          </p>
          <a href="/contact#enquiry" class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-800 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-900">
            Send a sourcing request <Icon name="arrow" class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
